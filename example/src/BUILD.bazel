load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_runfiles_group//runfiles_group:runfiles_group_analysis_test.bzl", "runfiles_group_analysis_test")
load("//consumer/rules:fake_package.bzl", "fake_package")
load("//producer/rules:asset_bundle.bzl", "asset_bundle")
load("//producer/rules:shared_bundle.bzl", "shared_bundle")
load("//producer/rules:skip_interpreter.bzl", "skip_interpreter")
load("//producer/rules:starlark_binary.bzl", "starlark_binary")
load("//producer/rules:starlark_library.bzl", "starlark_library")
load(
    "//src:group_names.bzl",
    "COLORS",
    "FIZZBUZZ",
    "IRS_F1040",
    "LIMITS",
    "MATHLIB",
    "STRINGUTIL",
    "TEMPLATES",
    "UNITS",
)

package(default_visibility = ["//visibility:public"])

P = "starlark_runfiles_group#"

# This is a mixin users can add to aspect_hints of a binary target to skip the interpreter group.
skip_interpreter(name = "skip_interpreter")

repo = repo_name() if repo_name() != "" else "_main"

# Work with generated source files
expand_template(
    name = "lib_a_generator",
    out = "lib_a.star",
    substitutions = {"{repo_name}": repo},
    template = "lib_a.star.tpl",
)

# Work with generated source files
expand_template(
    name = "lib_b_generator",
    out = "lib_b.star",
    substitutions = {"{repo_name}": repo},
    template = "lib_b.star.tpl",
)

starlark_library(
    name = "lib_a",
    srcs = ["lib_a.star"],
    data = ["a.txt"],
    # Its group inherits the ruleset-wide "starlark" merge_affinity.
    runfiles_weight = 10,
)

starlark_library(
    name = "lib_b",
    srcs = ["lib_b.star"],
    data = ["b.txt"],
    runfiles_weight = 40,
)

# A second, unrelated "ruleset". Everything it produces carries the
# "asset_bundle" merge_affinity (see producer/rules/asset_bundle.bzl), which is
# distinct from the "starlark" affinity used by starlark_library/starlark_binary.
asset_bundle(
    name = "assets_ui",
    srcs = ["assets/theme.conf"],
    weight = 11,
)

asset_bundle(
    name = "assets_docs",
    srcs = [
        "assets/README.md",
        "assets/messages.properties",
    ],
    weight = 12,
)

# adder pulls in groups from two rulesets at the same rank: the Starlark
# libraries (affinity "starlark") and the asset bundles (affinity
# "asset_bundle"). Both name their per-target groups by Label, which is why they
# can coexist without agreeing on a prefix. Its data files (a.txt, b.txt) arrive
# as synthesized per-target groups with no affinity (""). See the *_merged tests
# below for how merge_affinity keeps each ruleset's groups together.
starlark_binary(
    name = "adder",
    src = "adder.star",
    data = [
        ":assets_docs",
        ":assets_ui",
    ],
    runfiles_grouping = "by_target",
    deps = [
        ":lib_a",
        ":lib_b",
    ],
)

starlark_binary(
    name = "adder_without_interpreter",
    src = "adder.star",
    # Signal to the packaging rules:
    # Apply a transform to the runfiles grouping.
    aspect_hints = [":skip_interpreter"],
    runfiles_grouping = "by_target",
    deps = [
        ":lib_a",
        ":lib_b",
    ],
)

starlark_binary(
    name = "hasher",
    src = "hasher.star",
    data = ["@irs_f1040//file"],
    properties = {
        "IRS_F1040_PATH": "$(rlocationpath @irs_f1040//file)",
    },
)

starlark_binary(
    name = "3p_deps_demo",
    src = "3p_deps_demo.star",
    deps = [
        "@fizzbuzz",
        "@stringutil",
    ],
)

starlark_binary(
    name = "merge_demo",
    src = "merge_demo.star",
    deps = [
        "@colors",
        "@limits",
        "@mathlib",
        "@templates",
        "@units",
    ],
)

starlark_binary(
    name = "data_has_executable",
    src = "empty.star",
    data = ["//src/shell_app:greeter"],
)

# Two libraries listing the same data file. Each one synthesizes its own entry for
# Label("//src:shared.txt"), with its own runfiles object, so the binary's entry
# depset contains that group twice. Resolving folds the duplicates into one group
# by unioning their runfiles -- if it resolved last-wins instead, a pair of
# same-named groups with different contents would silently lose one side.
#
# srcs is empty on purpose: both libraries would otherwise need a source file each
# just to avoid overlapping with one another.
starlark_library(
    name = "lib_shares_a",
    data = ["shared.txt"],
)

starlark_library(
    name = "lib_shares_b",
    data = ["shared.txt"],
)

starlark_binary(
    name = "shared_data_demo",
    src = "empty.star",
    runfiles_grouping = "by_target",
    deps = [
        ":lib_shares_a",
        ":lib_shares_b",
    ],
)

# Two targets contributing to ONE named group, handing over the two different
# content forms: shared_docs_a hands over the depset of File itself, shared_docs_b
# a runfiles object. That is the only way a fold has to union the forms across
# producers, and runfiles_groups.resolve() has to lift the depset side to do it --
# which is why it takes a ctx. If it dropped either side instead, the completeness check
# below would fail with the missing file named.
shared_bundle(
    name = "shared_docs_a",
    srcs = ["docs_a.txt"],
    content_form = "files",
    group_name = "example#shared_docs",
)

shared_bundle(
    name = "shared_docs_b",
    srcs = ["docs_b.txt"],
    content_form = "runfiles",
    group_name = "example#shared_docs",
)

starlark_binary(
    name = "shared_group_demo",
    src = "empty.star",
    data = [
        ":shared_docs_a",
        ":shared_docs_b",
    ],
    runfiles_grouping = "by_target",
)

# A binary whose groups mix both name forms at the same rank. inner_by_repo emits
# *named* groups (one per repository), and mixed_forms takes it as a data dep
# alongside a library, whose group is named by Label -- so a Label and a string
# land in the same rank and the same merge bucket. Sorting or comparing them
# directly is an error in Starlark, so this is what pins the form discriminator
# in the sort keys: remove it and this target fails to analyze.
starlark_binary(
    name = "inner_by_repo",
    src = "adder.star",
    runfiles_grouping = "by_repo",
    deps = [
        ":lib_a",
        ":lib_b",
    ],
)

starlark_binary(
    name = "mixed_forms",
    src = "empty.star",
    data = [":inner_by_repo"],
    runfiles_grouping = "by_target",
    deps = [":lib_a"],
)

fake_package(
    name = "adder_pkg",
    binary = ":adder",
)

fake_package(
    name = "adder_without_interpreter_pkg",
    binary = ":adder_without_interpreter",
)

fake_package(
    name = "hasher_pkg",
    binary = ":hasher",
)

fake_package(
    name = "3p_deps_demo_pkg",
    binary = ":3p_deps_demo",
)

# This one test covers the "emits nothing when the switch is off" contract for
# every binary, so the per-binary tests below opt out of the disabled branch
# (check_disabled = False) instead of analyzing each closure a second time.
runfiles_group_analysis_test(
    name = "test_runfiles_group_invariants",
    binaries = [
        ":adder",
        ":adder_without_interpreter",
        ":hasher",
        ":3p_deps_demo",
        ":merge_demo",
        ":data_has_executable",
        ":shared_data_demo",
    ],
)

# Both name forms at the same rank and in the same merge bucket. max_groups drives
# the merge selection, whose tie-breaking also has to compare across the forms.
runfiles_group_analysis_test(
    name = "test_mixed_forms",
    binaries = [":mixed_forms"],
    check_disabled = False,
    expected_executable_group = P + "entrypoint",
    max_groups = 4,
    overlapping_group_behavior = "ignore",
)

# The shared data file must end up in exactly one group, and the completeness and
# overlap checks must both pass -- which they cannot if the fold duplicated or
# dropped it.
runfiles_group_analysis_test(
    name = "test_shared_data_groups",
    binaries = [":shared_data_demo"],
    check_disabled = False,
    expected_executable_group = P + "entrypoint",
    expected_group_names = [
        P + "interpreter",
        P + "std",
        "@@//src:lib_shares_a",
        "@@//src:lib_shares_b",
        "@@//src:shared.txt",
        P + "entrypoint",
    ],
    overlapping_group_behavior = "error",
)

# The contributors on their own, one per content form. Neither is a binary -- the
# test only needs DefaultInfo and RunfilesGroupInfo -- so this is also the cheapest
# place to check that a new producing rule honors the global switch, which is what
# check_disabled verifies. A group handed over as a depset must report empty
# symlinks, root symlinks and empty filenames, or the completeness check fails.
runfiles_group_analysis_test(
    name = "test_shared_bundle_forms",
    binaries = [
        ":shared_docs_a",
        ":shared_docs_b",
    ],
    expected_group_names = ["example#shared_docs"],
    overlapping_group_behavior = "error",
)

# The two contributors' files must both end up in the one shared group, which the
# completeness check enforces: a fold that kept only one form's contents would leave
# the other's file in default_runfiles and in no group at all.
runfiles_group_analysis_test(
    name = "test_shared_group_forms",
    binaries = [":shared_group_demo"],
    check_disabled = False,
    expected_executable_group = P + "entrypoint",
    expected_group_names = [
        P + "interpreter",
        P + "std",
        "example#shared_docs",
        P + "entrypoint",
    ],
    overlapping_group_behavior = "error",
)

# Per-binary tests: ordering without group limits
#
# adder mixes three merge affinities at rank RANK_EXECUTABLE - 1:
#   "asset_bundle": assets_docs(12), assets_ui(11)   (the other ruleset)
#   ""            : a.txt(0), b.txt(0)               (data deps, no affinity)
#   "starlark"    : lib_a(10), lib_b(40)             (this ruleset)

runfiles_group_analysis_test(
    name = "test_adder_groups",
    binaries = [":adder"],
    check_disabled = False,
    expected_executable_group = P + "entrypoint",
    expected_group_names = [
        P + "interpreter",
        P + "std",
        "@@//src:a.txt",
        "@@//src:assets_docs",
        "@@//src:assets_ui",
        "@@//src:b.txt",
        "@@//src:lib_a",
        "@@//src:lib_b",
        P + "entrypoint",
    ],
    overlapping_group_behavior = "error",
)

runfiles_group_analysis_test(
    name = "test_hasher_groups",
    binaries = [":hasher"],
    check_disabled = False,
    expected_executable_group = P + "_main",
    expected_group_names = [
        P + "interpreter",
        P + "std",
        P + IRS_F1040,
        P + "_main",
    ],
    overlapping_group_behavior = "error",
)

runfiles_group_analysis_test(
    name = "test_3p_deps_demo_groups",
    binaries = [":3p_deps_demo"],
    check_disabled = False,
    expected_executable_group = P + "_main",
    expected_group_names = [
        P + "interpreter",
        P + "std",
        P + FIZZBUZZ,
        P + STRINGUTIL,
        P + "_main",
    ],
    overlapping_group_behavior = "error",
)

# Per-binary tests: ordering with group limits

# max_groups=6: three merges, each within a single affinity, even though
# cheaper cross-affinity pairs exist (e.g. the free data merge plus a
# starlark/asset pair). merge_affinity consolidates each ruleset first:
#   assets_ui(11)+assets_docs(12)   -> one "asset_bundle" group
#   a.txt(0)+b.txt(0)               -> one "" group
#   lib_a(10)+lib_b(40)             -> one "starlark" group
runfiles_group_analysis_test(
    name = "test_adder_groups_merged",
    binaries = [":adder"],
    check_disabled = False,
    expected_executable_group = P + "entrypoint",
    expected_group_names = [
        P + "interpreter",
        P + "std",
        "@@//src:a.txt+@@//src:b.txt",
        "@@//src:assets_ui+@@//src:assets_docs",
        "@@//src:lib_a+@@//src:lib_b",
        P + "entrypoint",
    ],
    group_name_prefix = P,
    max_groups = 6,
    overlapping_group_behavior = "error",
)

# max_groups=5: no same-affinity pair remains, so merging falls back across
# affinities, joining the (cheapest) "" data group into the "asset_bundle" group.
runfiles_group_analysis_test(
    name = "test_adder_groups_cross_affinity",
    binaries = [":adder"],
    check_disabled = False,
    expected_executable_group = P + "entrypoint",
    expected_group_names = [
        P + "interpreter",
        P + "std",
        "@@//src:a.txt+@@//src:b.txt+@@//src:assets_ui+@@//src:assets_docs",
        "@@//src:lib_a+@@//src:lib_b",
        P + "entrypoint",
    ],
    group_name_prefix = P,
    max_groups = 5,
    overlapping_group_behavior = "error",
)

runfiles_group_analysis_test(
    name = "test_hasher_groups_merged",
    binaries = [":hasher"],
    check_disabled = False,
    # interpreter has do_not_merge, and the remaining groups are each alone
    # in their rank, so merging cannot reduce below 4.
    expected_group_count = 4,
    expected_group_names = [
        P + "interpreter",
        P + "std",
        P + IRS_F1040,
        P + "_main",
    ],
    group_name_prefix = P,
    max_groups = 2,
    overlapping_group_behavior = "error",
)

runfiles_group_analysis_test(
    name = "test_3p_deps_demo_groups_merged",
    binaries = [":3p_deps_demo"],
    check_disabled = False,
    # fizzbuzz and stringutil (both rank 0) merge into fizzbuzz+stringutil.
    expected_group_names = [
        P + "interpreter",
        P + "std",
        P + FIZZBUZZ + "+" + STRINGUTIL,
        P + "_main",
    ],
    group_name_prefix = P,
    max_groups = 4,
    overlapping_group_behavior = "error",
)

# merge_demo tests: 8 groups total. All groups are produced by starlark rules,
# so they all share the "starlark" affinity — merging therefore falls back to
# pure weight order within each rank (same result as if no affinity were set).
# rank RANK_FOUNDATION      : interpreter (do_not_merge)
# rank RANK_FOUNDATION + 100: std
# rank RANK_SHARED_DEPS     : colors(42), limits(43), units(40), mathlib(2296), templates(7092)
# rank RANK_EXECUTABLE      : _main

fake_package(
    name = "merge_demo_pkg",
    binary = ":merge_demo",
)

runfiles_group_analysis_test(
    name = "test_merge_demo_groups",
    binaries = [":merge_demo"],
    check_disabled = False,
    expected_executable_group = P + "_main",
    expected_group_names = [
        P + "interpreter",
        P + "std",
        P + COLORS,
        P + LIMITS,
        P + MATHLIB,
        P + TEMPLATES,
        P + UNITS,
        P + "_main",
    ],
    overlapping_group_behavior = "error",
)

# max_groups=6: merge the 3 tiny constant libs
# units(40)+colors(42) -> "units+colors"(82), then limits(43)+"units+colors"(82) -> "limits+units+colors"(125)
runfiles_group_analysis_test(
    name = "test_merge_demo_max6",
    binaries = [":merge_demo"],
    check_disabled = False,
    expected_group_names = [
        P + "interpreter",
        P + "std",
        P + LIMITS + "+" + UNITS + "+" + COLORS,
        P + MATHLIB,
        P + TEMPLATES,
        P + "_main",
    ],
    group_name_prefix = P,
    max_groups = 6,
    overlapping_group_behavior = "error",
)

# max_groups=5: also merges "limits+units+colors"(125) into mathlib(2296)
runfiles_group_analysis_test(
    name = "test_merge_demo_max5",
    binaries = [":merge_demo"],
    check_disabled = False,
    expected_group_names = [
        P + "interpreter",
        P + "std",
        P + LIMITS + "+" + UNITS + "+" + COLORS + "+" + MATHLIB,
        P + TEMPLATES,
        P + "_main",
    ],
    group_name_prefix = P,
    max_groups = 5,
    overlapping_group_behavior = "error",
)

# max_groups=4: also merges into templates, leaving one rank-0 group
runfiles_group_analysis_test(
    name = "test_merge_demo_max4",
    binaries = [":merge_demo"],
    check_disabled = False,
    expected_group_names = [
        P + "interpreter",
        P + "std",
        P + LIMITS + "+" + UNITS + "+" + COLORS + "+" + MATHLIB + "+" + TEMPLATES,
        P + "_main",
    ],
    group_name_prefix = P,
    max_groups = 4,
    overlapping_group_behavior = "error",
)

# max_groups=3: cannot reduce further (interpreter is do_not_merge,
# remaining groups are each alone in their rank)
runfiles_group_analysis_test(
    name = "test_merge_demo_max3",
    binaries = [":merge_demo"],
    check_disabled = False,
    expected_executable_group = P + "_main",
    expected_group_count = 4,
    expected_group_names = [
        P + "interpreter",
        P + "std",
        P + LIMITS + "+" + UNITS + "+" + COLORS + "+" + MATHLIB + "+" + TEMPLATES,
        P + "_main",
    ],
    group_name_prefix = P,
    max_groups = 3,
    overlapping_group_behavior = "error",
)

starlark_binary(
    name = "ungrouped",
    src = "empty.star",
    runfiles_grouping = "disabled",
)

fake_package(
    name = "ungrouped_pkg",
    binary = ":ungrouped",
)
