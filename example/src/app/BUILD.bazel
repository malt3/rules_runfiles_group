load("@rules_runfiles_group//runfiles_group:runfiles_group_analysis_test.bzl", "runfiles_group_analysis_test")
load("//producer/rules:starlark_app.bzl", "HAS_LABEL_LIST_DICT", "starlark_app")
load("//producer/rules:starlark_binary.bzl", "starlark_binary")
load("//producer/rules:starlark_library.bzl", "starlark_library")

P = "starlark_runfiles_group#"

# A pluggable app, assembled from libraries reached through every Label-typed
# attribute kind Bazel has: attr.label (main), attr.label_list (deps),
# attr.string_keyed_label_dict (plugins), attr.label_keyed_string_dict
# (pinned_versions) and attr.label_list_dict (optional_features). All five are
# dependency attributes, so starlark_app hands all five to one
# runfiles_groups.collect(deps = [...]) call -- see producer/rules/starlark_app.bzl.
#
# What this package pins down: every library in every one of those attributes has
# to end up in a group. The rule builds its DefaultInfo by flattening the
# attributes by hand and its RunfilesGroupInfo through runfiles_groups.collect(),
# so a library the attribute walking misses lands in default_runfiles and in no
# group, which is exactly what the completeness check in
# runfiles_group_analysis_test reports.

starlark_library(
    name = "core",
    srcs = ["core.star"],
)

starlark_library(
    name = "util",
    srcs = ["util.star"],
)

starlark_library(
    name = "plugin_greet",
    srcs = ["plugin_greet.star"],
)

starlark_library(
    name = "plugin_clock",
    srcs = ["plugin_clock.star"],
)

starlark_library(
    name = "vendored_json",
    srcs = ["vendored_json.star"],
)

starlark_library(
    name = "feature_units",
    srcs = ["feature_units.star"],
)

starlark_app(
    name = "demo_app",
    data = ["registry_defaults.json"],
    main = ":core",
    optional_features = {"units": [":feature_units"]},
    pinned_versions = {":vendored_json": "2.14.0"},
    plugins = {
        "clock": ":plugin_clock",
        "greet": ":plugin_greet",
    },
    # plugin_clock is registered as a plugin above as well. A library reached
    # through two attributes propagates the same entry depset twice and must still
    # end up in exactly one group, which overlapping_group_behavior = "error"
    # checks.
    deps = [
        ":plugin_clock",
        ":util",
    ],
)

starlark_binary(
    name = "demo",
    src = "main.star",
    runfiles_grouping = "by_target",
    deps = [":demo_app"],
)

# One group per target reached through the app, all of them in this repository and
# therefore at the same rank -- so they are ordered by Label, which for one package
# is the target name. attr.label_list_dict is Bazel 9 and newer; on 7 and 8 the app
# has no optional_features attribute and never reaches feature_units (see
# starlark_app.bzl), so its group is expected only where the attribute exists.
runfiles_group_analysis_test(
    name = "test_demo_groups",
    binaries = [":demo"],
    expected_executable_group = P + "entrypoint",
    expected_group_names = [
        P + "interpreter",
        P + "std",
    ] + sorted([
        "@@//src/app:core",
        "@@//src/app:demo_app",
        "@@//src/app:plugin_clock",
        "@@//src/app:plugin_greet",
        "@@//src/app:registry_defaults.json",
        "@@//src/app:util",
        "@@//src/app:vendored_json",
    ] + (["@@//src/app:feature_units"] if HAS_LABEL_LIST_DICT else [])) + [
        P + "entrypoint",
    ],
    overlapping_group_behavior = "error",
)
